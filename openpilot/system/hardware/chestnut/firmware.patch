+static volatile uint8_t ss_retry_pending;
+/* CC31 preserves XDATA; crt0 clears IDATA. Preserve the retry budget so a
+ * real USB2 cable cannot cause an unbounded software reset loop. */
+static __xdata volatile uint8_t ss_retry_magic_a;
+static __xdata volatile uint8_t ss_retry_magic_b;
+static __xdata volatile uint8_t ss_retry_count;
+static volatile uint8_t payload_started;
+
+/* Timer 3 mode follows upstream PR84. Poll it with no timer IRQ enabled.
+ * Limit recovery to two idle USB2 configurations; leave active USB2 alone. */
+static void schedule_ss_retry(void) {
+  ss_retry_pending = 0;
+  REG_TIMER3_CSR = TIMER_CSR_CLEAR;
+  REG_TIMER3_CSR = TIMER_CSR_EXPIRED;
+  if (is_usb2 && ss_retry_count < 2) {
+    REG_TIMER3_DIV = (REG_TIMER3_DIV & 0xE8) | 0x04;
+    XDATA_REG8(0xCC24) = 40000U >> 8;
+    XDATA_REG8(0xCC25) = 40000U & 0xFF;
+    REG_TIMER3_CSR = TIMER_CSR_ENABLE;
+    ss_retry_pending = 1;
+  }
+}
 
