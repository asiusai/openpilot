import ctypes.util
import glob
import os
import shlex
from SCons.Script import Action, Value, ARGUMENTS
from SCons.Errors import UserError
from openpilot.common.transformations.camera import _ar_ox_fisheye, _os_fisheye
from openpilot.common.transformations.model import MEDMODEL_INPUT_SIZE, DM_INPUT_SIZE
from openpilot.system.camerad.cameras.nv12_info import get_nv12_info


Import('env', 'arch', 'ASIUS_HARDWARE')

# TODO: add GCC support to tinygrad?
# tinygrad's CPU:LLVM backend requires libLLVM, skip the build on PC if it's not available
if arch not in ('comma_arm64', 'Darwin') and ctypes.util.find_library('LLVM') is None:
  print("\033[93mmodeld: LLVM not found, skipping tinygrad model compilation. Install LLVM to compile models.\033[0m")
  Return()

lenv = env.Clone()
lenv.PrependENVPath('PYTHONPATH', Dir('#tinygrad_repo').abspath)

tinygrad_root = env.Dir("#").abspath
tinygrad_files = ["#"+x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**", recursive=True, root_dir=tinygrad_root)
                  if 'pycache' not in x and os.path.isfile(os.path.join(tinygrad_root, x))]

camera_configs = [(c.width, c.height) for c in (_ar_ox_fisheye, _os_fisheye)]

if arch == 'comma_arm64':
  tg_flags = 'DEV=QCOM IMAGE=1 FLOAT16=1 NOLOCALS=1 JIT_BATCH_SIZE=0 OPENPILOT_HACKS=1'
else:
  # JIT=2 disables graph batching, which produces incorrect outputs after buffers change.
  # Use Apple's clang for the CPU helper runtime without requiring libLLVM.
  tg_flags = 'DEV=METAL HCQ_RUNTIME_DEV=CPU:CLANG JIT=2' if arch == 'Darwin' else 'DEV=CPU:LLVM'

driving_tg_flags = tg_flags.replace(' NOLOCALS=1', '') if ASIUS_HARDWARE else tg_flags

# tinygrad calls brew which needs a $HOME in the env
mac_brew_string = f'HOME={os.path.expanduser("~")}' if arch == 'Darwin' else ''

warp_deps = [File("#openpilot/system/camerad/cameras/nv12_info.py")]
compiler = Dir('#tinygrad_repo/examples/openpilot').abspath
# build on all cores
taskset = 'taskset -c 0-7 ' if arch == 'comma_arm64' else ''

def compile_model(onnx_path, pkl_path, flags=tg_flags):
  onnx_path, target_pkl_path = File(onnx_path).abspath, File(pkl_path).abspath
  cmd = (f'{flags} {mac_brew_string} {taskset}python3 "{compiler}/compile_onnx.py" '
         f'"{onnx_path}" "{target_pkl_path}" --out-of-band --benchmark-runs 1')
  lenv.Command(
    target_pkl_path,
    tinygrad_files + [onnx_path, Value(cmd)],
    Action(cmd, "  [ONNX] $TARGET"),
  )

qnn_context = ARGUMENTS.get('qnn_dmonitoring_context')
qnn_sample = ARGUMENTS.get('qnn_dmonitoring_sample')
if bool(qnn_context) != bool(qnn_sample):
  raise UserError('qnn_dmonitoring_context and qnn_dmonitoring_sample must be provided together')
if qnn_context:
  if not ASIUS_HARDWARE or arch != 'comma_arm64':
    raise UserError('Package QNN models on the Dragon target')
  source = File('models/dmonitoring_model.onnx').abspath
  target = File('models/dmonitoring_model_tinygrad.pkl').abspath
  context, sample = File(qnn_context).abspath, File(qnn_sample).abspath
  cmd = 'DEV=QNN ' + shlex.join(['python3', f'{compiler}/compile_qnn.py', source, context, target, '--sample', sample])
  lenv.Command(target, tinygrad_files + [source, context, sample, Value(cmd)], Action(cmd, '  [QNN] $TARGET'))
else:
  compile_model('models/dmonitoring_model.onnx', 'models/dmonitoring_model_tinygrad.pkl')
driving_qnn = {name: ARGUMENTS.get(f'qnn_driving_{name}') for name in ('context', 'sample', 'pre', 'post')}
if any(driving_qnn.values()):
  if not all(driving_qnn.values()):
    raise UserError('qnn_driving_context, qnn_driving_sample, qnn_driving_pre and qnn_driving_post must be provided together')
  if not ASIUS_HARDWARE or arch != 'comma_arm64':
    raise UserError('Package QNN models on the Dragon target')
  paths = {name: File(path).abspath for name, path in driving_qnn.items()}
  source = File('models/driving_supercombo.onnx').abspath
  target = File('models/driving_tinygrad.pkl').abspath
  cmd = 'DEV=QCOM IMAGE=1 FLOAT16=0 NOLOCALS=1 JIT_BATCH_SIZE=0 OPENPILOT_HACKS=1 ' + shlex.join([
    'python3', f'{compiler}/compile_qnn.py', source, paths['context'], target,
    '--sample', paths['sample'], '--pre', paths['pre'], '--post', paths['post']])
  lenv.Command(target, tinygrad_files + [source, *paths.values(), Value(cmd)], Action(cmd, '  [QNN] $TARGET'))
else:
  compile_model('models/driving_supercombo.onnx', 'models/driving_tinygrad.pkl', driving_tg_flags)

model_w, model_h = MEDMODEL_INPUT_SIZE
for cam_w, cam_h in camera_configs:
  warp_pkl_path = File(f"models/driving_warp_{cam_w}x{cam_h}_tinygrad.pkl").abspath
  stride, y_height, uv_height, _ = get_nv12_info(cam_w, cam_h)
  cmd = (f'{driving_tg_flags} {mac_brew_string} {taskset}python3 "{compiler}/compile_warp.py" '
         f'--frame {cam_w},{cam_h},{stride},{y_height},{uv_height},{stride * (y_height + uv_height)} '
         f'--warp-to {model_w}x{model_h} --layout yuv420 --frames 2 '
         f'--output {warp_pkl_path}')
  lenv.Command(warp_pkl_path, tinygrad_files + warp_deps + [Value(cmd)], cmd)

dm_w, dm_h = DM_INPUT_SIZE
for cam_w, cam_h in camera_configs:
  dm_pkl_path = File(f"models/dm_warp_{cam_w}x{cam_h}_tinygrad.pkl").abspath
  stride, y_height, uv_height, frame_size = get_nv12_info(cam_w, cam_h)
  cmd = (f'{tg_flags} {mac_brew_string} python3 "{compiler}/compile_warp.py" '
         f'--frame {cam_w},{cam_h},{stride},{y_height},{uv_height},{frame_size} --warp-to {dm_w}x{dm_h} '
         f'--layout luma --border-fill 16 --transform-device NPY --output {dm_pkl_path}')
  lenv.Command(dm_pkl_path, tinygrad_files + warp_deps + [Value(cmd)], cmd)
